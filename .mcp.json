{
  "mcpServers": {
    "mindie-tools": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--script",
        "${OMP_PLUGIN_ROOT}/scripts/mindie_launch.py",
        "tools"
      ],
      "timeout": 510000
    },
    "mindie-remote-dev": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--script",
        "${OMP_PLUGIN_ROOT}/scripts/mindie_launch.py",
        "remote"
      ],
      "timeout": 720000
    }
  }
}
